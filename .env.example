# 로컬 개발: Next rewrites 프록시 대상 BE (docs/specs/07)
BE_ORIGIN=http://localhost:3000

# API base — 반드시 비워둘 것 (same-origin 프록시).
# 소셜 로그인 콜백이 이 오리진의 /api/v1/...으로 들어와야 발급 쿠키가
# FE와 same-origin(first-party)으로 저장된다 (docs/specs/17).
# 값을 넣어 브라우저가 BE를 직접 호출하면 쿠키가 BE 도메인에 저장돼 로그인이 유지되지 않는다.
NEXT_PUBLIC_API_BASE_URL=

# OG 이미지·정규 URL의 절대경로 기준 오리진. 비워두면 Vercel 배포 도메인을 쓰고,
# 로컬에서는 http://localhost:3001 로 떨어진다. 커스텀 도메인을 붙였으면 여기에 고정한다.
NEXT_PUBLIC_SITE_URL=

# ─── 소셜 로그인 (docs/specs/17) ────────────────────────
# BE의 OAUTH_WEB_BASE_URL은 이 앱의 오리진과 같아야 한다.
#   로컬:  http://localhost:3001
#   배포:  https://<vercel-도메인>
# 각 제공자 콘솔에 등록할 Redirect URI:
#   {이 앱의 오리진}/api/v1/auth/oauth/{google|kakao|naver}/callback
